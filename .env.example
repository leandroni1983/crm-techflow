# Copiá este archivo como .env y editalo. NUNCA lo subas a un repositorio.

# ===== Base de datos =====
# Elegí UNA de las dos.
# a) Local (contenedor "db" de este compose; arranca solo con `docker compose up -d`):
DATABASE_URL=postgresql://crm:CAMBIAME@db:5432/crm
# b) Nube (levantá solo el CRM con `docker compose up -d crm`). TLS obligatorio. Si la clave tiene símbolos, codificalos (@ -> %40, # -> %23, / -> %2F):
# DATABASE_URL=postgresql://usuario:clave@host-del-proveedor:5432/nombre?sslmode=require

# Solo para la base local (opción a). Tienen que coincidir con la URL de arriba.
POSTGRES_USER=crm
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=crm

# ===== Archivos (fotos, firmas, comprobantes) =====
# Carpeta del host, FUERA del proyecto. Obligatoria: si falta, docker compose no arranca.
DATA_PATH=/srv/crm/data

# ===== App =====
# Versión de la imagen en Docker Hub (leandrocode/crmtech:<versión>). Subila cada vez que cambies el código.
CRM_VERSION=1.4.0
PORT=8000
TZ=America/Argentina/Buenos_Aires
PUID=1000
PGID=1000

# ===== Primer ingreso (solo se usan si todavía no hay usuarios) =====
ADMIN_USER=admin
ADMIN_PASSWORD='cambiame-por-algo-largo'

# ===== Detrás de Cloudflare / HTTPS =====
COOKIE_SECURE=0
TRUST_PROXY=0
